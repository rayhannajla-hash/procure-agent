# PayPal REST app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Channel3 product search (https://trychannel3.com/developers)
CHANNEL3_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey). Without it the app runs a fixed, non-AI playbook.
GEMINI_API_KEY=
# Optional: models tried in order when one is unavailable or out of quota.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Optional
# PORT=8788
# RUNS_PER_HOUR=10
# MAX_CONCURRENT=2
# ALLOW_RESET=1
